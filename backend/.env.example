# Server
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database - Supabase (Recommended)
# Direct connection (use for Prisma migrations)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Connection pooling (use for production/serverless)
DATABASE_URL_POOLING="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# OR Local PostgreSQL (Alternative)
# DATABASE_URL="postgresql://user:password@localhost:5432/rfq_platform?schema=public"

# Supabase Project Configuration (optional - for Supabase Auth/Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key-here"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@example.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# R2D Freshness Rules
HIGH_VELOCITY_EXPIRY_HOURS=72
STANDARD_EXPIRY_HOURS=336
